# /.env.example
# ATENCIÓN!!! La aplicación de usuarios se llama 'users' pero el Namespace a usar es 'usuarios'

# ---- Configuración General de Django ----
# IMPORTANTE: Genera tu propia clave secreta con 'python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"'
DJANGO_SECRET_KEY=""
DJANGO_DEBUG="False"
# Lista de hosts permitidos separados por comas. Ejemplo: "www.dominio.com,sub.dominio.com"
DJANGO_ALLOWED_HOSTS="www.campustudionline.com,MiguelAeTxio.pythonanywhere.com"
# La URL completa de tu sitio, sin barra al final.
SITE_URL="https://www.campustudionline.com"

# ---- Base de Datos (MySQL) ----
DB_NAME_PROD=""
DB_USER_PROD=""
DB_PASSWORD_PROD=""
DB_HOST_PROD=""
DB_PORT_PROD="3306"

# ---- Envío de Emails (MailerSend) ----
# Esta es la API Token generada desde el panel de MailerSend.
MAILERSEND_API_TOKEN=""
DEFAULT_FROM_EMAIL="noreply@campustudionline.com"

# ---- Canales y Redis ----
# URL de conexión a tu servidor Redis.
REDIS_URL="redis://localhost:6379/0"

# ---- Google reCAPTCHA ----
RECAPTCHA_PUBLIC_KEY_PROD=""
RECAPTCHA_PRIVATE_KEY_PROD=""

# ---- Seguridad y URLs Personalizadas ----
# Orígenes de confianza para CSRF, separados por comas.
DJANGO_CSRF_TRUSTED_ORIGINS="https://www.campustudionline.com,https://MiguelAeTxio.pythonanywhere.com"
# Segmento de la URL para el panel de administración de Django.
DJANGO_ADMIN_URL_SEGMENT="admin/"
# IPs permitidas para acceder en modo mantenimiento, separadas por comas.
MAINTENANCE_MODE_ALLOWED_IPS=""

# ---- Notificaciones Push (VAPID) ----
# Generar con 'vapid --generate' o herramientas online.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_ADMIN_EMAIL=""

# ---- APIs de Terceros ----
# Clave de API para el servicio de IA Generativa de Google.
GEMINI_API_KEY=""
# Límite diario de peticiones a la API de IA por cada usuario.
GEMINI_DAILY_REQUESTS_PER_USER="3"
# Límite global de Peticiones Por Minuto (PPM) para toda la plataforma (red de seguridad).
GEMINI_GLOBAL_PPM="50"