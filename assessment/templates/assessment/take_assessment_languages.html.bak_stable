{% extends "base.html" %}
{% load static %}{% load assessment_tags %}
{% block extra_css %}
<style>
.btn-media-45 { width: 45px !important; height: 45px !important; border-radius: 50% !important; display: flex !important; align-items: center; justify-content: center; }
.audio-wave { display: inline-flex; align-items: center; gap: 3px; height: 20px; vertical-align: middle; }
.audio-wave span { display: block; width: 3px; height: 6px; background-color: #bb86fc; border-radius: 2px; animation: wave 1s infinite ease-in-out; }
@keyframes wave { 0%, 100% { height: 6px; opacity: 0.6; } 50% { height: 20px; opacity: 1; } }
.upload-dashed { border: 2px dashed #dee2e6; border-radius: 15px; background: #fafafa; transition: all 0.3s; position: relative; cursor: pointer; overflow: hidden; min-height: 120px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.upload-dashed p { padding: 0 10px; line-height: 1.2; width: 100%; }
.upload-dashed:hover { border-color: #0d6efd; background: #f8faff; }
.upload-dashed input[type="file"] { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
</style>
{% endblock %}
{% block content %}
<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white py-3"><h1 class="h4 mb-0 fw-bold">{{ page_title }}</h1></div>
        <div class="card-body p-4">
            {% if assessment.reading_stimulus %}
            <div class="alert alert-light border shadow-sm mb-5 p-4 rounded-4">
                <h5 class="text-primary fw-bold mb-3"><i class="fas fa-book-reader me-2"></i>{{ assessment.prompt_data.ui_labels.reading_header|default:"TEXTO DE REFERENCIA" }}</h5>
                <div class="p-3 bg-white rounded-3 shadow-sm" style="font-size:1.1rem; line-height:1.8;">
                    {{ assessment.reading_stimulus|render_markdown }}
                </div>
            </div>
            {% endif %}
            <form id="assessment-form" method="POST" enctype="multipart/form-data" action="{% url 'assessment:submit_assessment' pk=assessment.pk %}">
                {% csrf_token %}
                <ol class="list-unstyled">
                    {% for question in questions_list %}
                        <li class="mb-5 p-4 bg-white border rounded-4 shadow-sm" id="q_{{ question.pk }}">
                            {% if question.section_label %}<small class="text-primary fw-bold text-uppercase d-block mb-2"><i class="fas fa-tag me-1"></i> {{ question.section_label }}</small>{% endif %}
                            <h5 class="fw-bold mb-4">
                                {{ forloop.counter }}. 
                                {% if question.interaction_type == "QT_CLZ_OPT" or question.interaction_type == "QT_CLZ_OPN" %}
                                    {% render_cloze_engine question.question_text question.response_mode question.pk question.options %}
                                {% else %}
                                    {{ question.display_text|render_markdown }}
                                {% endif %}
                            </h5>
                            {% if question.response_mode == "REQ_RADIO" %}
                                <div class="list-group rounded-4 shadow-sm border-0">
                                    {% for option in question.options %}<label class="list-group-item list-group-item-action py-3"><input class="form-check-input me-3" type="radio" name="answer_q_{{ question.pk }}" value="{{ option }}" required>{{ option }}</label>{% endfor %}
                                </div>
                            {% elif question.response_mode == "REQ_DUAL" %}
                                <div class="form-floating mb-4"><textarea name="answer_q_{{ question.pk }}" class="form-control rounded-4 shadow-sm" style="height: 180px" placeholder="." required></textarea><label>{{ assessment.prompt_data.ui_labels.write_answer_placeholder|default:"" }}</label></div>
                                <div class="upload-dashed p-4 text-center">
                                    <i class="fas fa-camera text-primary fa-2x mb-2"></i>
                                    <p class="small text-muted mb-1"><strong>Subir archivo (Foto)</strong></p>
                                    <p class="x-small text-muted mb-0">Clic o arrastrar</p>
                                    <input type="file" name="attachment_q_{{ question.pk }}" accept="image/*" onchange="AssessmentMedia.ui.updateUpload(this, '{{ question.pk }}')">
                                    <div id="file_preview_{{ question.pk }}" class="mt-2 d-none text-success small fw-bold"><i class="fas fa-check-circle"></i> <span id="file_name_{{ question.pk }}"></span></div>
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
                <div class="d-grid gap-2"><button type="submit" class="btn btn-success btn-lg py-3 rounded-4 shadow-lg fw-bold text-uppercase"><i class="fas fa-paper-plane me-2"></i> {{ assessment.prompt_data.ui_labels.submit_button|default:"Finalizar y Entregar Examen" }}</button></div>
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-start shadow-lg border-0" tabindex="-1" id="offcanvasRef" style="width: 85%;">
    <div class="offcanvas-header bg-primary text-white py-3"><h5 class="fw-bold"><i class="fas fa-book-open me-2"></i> Material de Referencia</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button></div>
    <div class="offcanvas-body p-4 fs-5" style="line-height: 1.8;">
        {% if assessment.reading_stimulus %}
            {{ assessment.reading_stimulus|render_markdown }}
        {% else %}
            {{ user_copy.original_content.get_full_markdown_content|render_markdown }}
        {% endif %}
    </div>
</div>
<div class="position-fixed top-50 start-0 translate-middle-y ms-2" style="z-index: 1060;">
    <button class="btn btn-primary rounded-circle shadow-lg p-3 border-0" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRef" title="Ver Texto Referencia"><i class="fas fa-book-open fa-lg"></i></button>
</div>
{% endblock %}
