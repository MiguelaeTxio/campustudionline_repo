import re
import json

def is_minor_language(subject_name):
    name = subject_name.upper()
    return any(x in name for x in ["MINOR", "MÍNOR", "IDIOMA MODERNO", "LENGUA C", "INICIAL", "A1", "A2"])

def get_target_language(subject_name):
    name = subject_name.upper()
    langs = {
        "CHINO": "CHINESE", "CHINESE": "CHINESE", "中文": "CHINESE",
        "FRANC": "FRENCH", "ALEM": "GERMAN", "JAPON": "JAPANESE",
        "ITALIA": "ITALIAN", "PORTU": "PORTUGUESE", "RUSO": "RUSSIAN", "ARABE": "ARABIC"
    }
    for key, val in langs.items():
        if key in name: return val
    return "ENGLISH"

def get_localized_labels(target_lang):
    if "CHINESE" in target_lang:
        return ["Vocabulario (词汇)", "Gramática (语法)", "Orden de Frase (语序)", "Escritura (写作)"]
    return ["Vocabulario", "Gramática", "Ordenación de Frases", "Expresión Escrita"]

def get_strategy_skeleton(content_text, subject_name, **kwargs):
    target_lang = get_target_language(subject_name)
    lbls = get_localized_labels(target_lang)
    itinerary = kwargs.get('itinerary') or ("MINOR" if is_minor_language(subject_name) else "MAIOR")

    skeleton = []
    if itinerary == "MINOR":
        # 17 ítems (Realidad UGR Minor)
        for _ in range(5): skeleton.append({'section_label': lbls[0], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
        for _ in range(5): skeleton.append({'section_label': lbls[1], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_CLZ_OPT', 'response_mode': 'REQ_DROP'})
        for _ in range(5): skeleton.append({'section_label': lbls[2], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_ORDER', 'response_mode': 'REQ_ORDER'})
        for _ in range(2): skeleton.append({'section_label': lbls[3], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_DUAL'})
        return {'requires_api_stimulus': False, 'skeleton': skeleton, 'itinerary': itinerary, 'target_lang': target_lang}
    else:
        # MAIOR: 36 ítems (Modelo Acreditación CertAcles)
        # Reading (10)
        for _ in range(10): skeleton.append({'section_label': "Reading Comprehension", 'source_type': 'SRC_TXT', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
        # Use of Language (15)
        for _ in range(10): skeleton.append({'section_label': "Multiple Choice Cloze", 'source_type': 'SRC_DIR', 'interaction_type': 'QT_CLZ_OPT', 'response_mode': 'REQ_DROP'})
        for _ in range(5): skeleton.append({'section_label': "Keyword Transformation", 'source_type': 'SRC_DIR', 'interaction_type': 'QT_TRF', 'response_mode': 'REQ_INPUT'})
        # Listening (8)
        for _ in range(8): skeleton.append({'section_label': "Listening Comprehension", 'source_type': 'SRC_AUD', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
        # Writing (2) + Speaking (1)
        for _ in range(2): skeleton.append({'section_label': "Writing Task", 'source_type': 'SRC_DIR', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_DUAL'})
        skeleton.append({'section_label': "Speaking / Oral Interaction", 'source_type': 'SRC_AUD', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_REC'})
        
        return {'requires_api_stimulus': True, 'prompt_func': 'generate_languages_stimuli_prompt', 'skeleton': skeleton, 'itinerary': itinerary, 'target_lang': target_lang}

def generate_languages_stimuli_prompt(content_text, subject_name):
    target_lang = get_target_language(subject_name)
    return f"""ACT AS AN ACADEMIC EXAM CHAIR.
TASK: Generate base stimuli for a {target_lang} specialist exam.
CONTEXT: {subject_name}.
CONTENT: {content_text[:1500]}

OUTPUT JSON:
1. 'reading_stimulus': A professional article (500 words) in {target_lang}.
2. 'listening_transcript': A formal conversation script in {target_lang}.
"""

def generate_languages_item_prompt(reading_text, listening_transcript, cefr_level, question_obj, itinerary='MAIOR', target_lang='ENGLISH'):
    q_type = question_obj.interaction_type
    if itinerary == 'MINOR':
        return f"""ACT AS AN HSK EXAM CREATOR (A1-A2). NO READING PASSAGES.
TARGET: {target_lang}. RULE: Instructions in Spanish, Content in {target_lang}. NO ENGLISH.
FIELD 'model_answer': MANDATORY.
JSON: {{"question_text": "...", "options": ["...", "..."], "model_answer": "..."}}"""
    
    # [HITO 6] PROMPT AVANZADO MAIOR (INMERSIÓN TOTAL)
    return f"""ACT AS A CERTACLES EXAMINAER ({cefr_level} LEVEL).
STRICT IMMERSION: Use 100% {target_lang}. NO Spanish, NO English.

TASK: Create ONE (1) {q_type} question.
REFERENCE: {reading_text[:800] if 'SRC_TXT' in question_obj.source_type else 'General Language Knowledge'}

INSTRUCTIONS:
1. If {q_type} is 'QT_TRF': Provide a lead-in sentence and a keyword for re-writing.
2. If {q_type} is 'QT_PROD': Provide a formal prompt for an essay or oral task.
3. Ensure 'model_answer' is highly accurate for this level.

JSON SCHEMA: {{"question_text": "...", "options": ["...", "..."], "model_answer": "..."}}
"""
