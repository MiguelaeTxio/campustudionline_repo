import json

def is_minor_language(subject_name):
    name = subject_name.upper()
    return any(x in name for x in ["MINOR", "MÍNOR", "IDIOMA MODERNO", "LENGUA C", "INICIAL", "A1", "A2"])

def get_target_language(subject_name):
    name = subject_name.upper()
    langs = {
        "CHINO": "CHINESE", "CHINESE": "CHINESE", "中文": "CHINESE",
        "FRANC": "FRENCH", "ALEM": "GERMAN", "JAPON": "JAPANESE",
        "ITALIA": "ITALIAN", "PORTU": "PORTUGUESE", "RUSO": "RUSSIAN", "ARABE": "ARABIC"
    }
    for key, val in langs.items():
        if key in name: return val
    return "ENGLISH"

def get_localized_labels(target_lang, itinerary="MINOR"):
    """Returns labels and stimulus headers for the specific language/itinerary."""
    if itinerary == "MINOR":
        if "CHINESE" in target_lang:
            return ["Vocabulario (词汇)", "Gramática (语法)", "Orden de Frase (语序)", "Escritura (写作)"]
        return ["Vocabulario", "Gramática", "Ordenación de Frases", "Expresión Escrita"]
    
    # MAIOR Localized Headers for the Template
    headers = {
        "ITALIAN": {"reading": "TESTO DI RIFERIMENTO", "q_reading": "Comprensione del testo", "q_grammar": "Uso della lingua", "q_writing": "Produzione scritta"},
        "FRENCH": {"reading": "TEXTE DE RÉFÉRENCE", "q_reading": "Compréhension écrite", "q_grammar": "Utilisation de la langue", "q_writing": "Production écrite"},
        "GERMAN": {"reading": "REFERENZTEXT", "q_reading": "Leseverstehen", "q_grammar": "Sprachgebrauch", "q_writing": "Schriftlicher Ausdruck"},
        "CHINESE": {"reading": "参考文本 (Cānkǎo wénběn)", "q_reading": "阅读理解", "q_grammar": "语法应用", "q_writing": "写作练习"}
    }
    return headers.get(target_lang, {"reading": "REFERENCE TEXT", "q_reading": "Reading Comprehension", "q_grammar": "Use of Language", "q_writing": "Writing Task"})

def get_strategy_skeleton(content_text, subject_name, **kwargs):
    target_lang = get_target_language(subject_name)
    itinerary = kwargs.get('itinerary') or ("MINOR" if is_minor_language(subject_name) else "MAIOR")
    lbls = get_localized_labels(target_lang, itinerary)

    skeleton = []
    if itinerary == "MINOR":
        for _ in range(5): skeleton.append({'section_label': lbls[0], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
        for _ in range(5): skeleton.append({'section_label': lbls[1], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_CLZ_OPT', 'response_mode': 'REQ_DROP'})
        for _ in range(5): skeleton.append({'section_label': lbls[2], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_ORDER', 'response_mode': 'REQ_ORDER'})
        for _ in range(2): skeleton.append({'section_label': lbls[3], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_DUAL'})
        return {'requires_api_stimulus': False, 'skeleton': skeleton, 'itinerary': itinerary, 'target_lang': target_lang}
    else:
        for _ in range(10): skeleton.append({'section_label': lbls['q_reading'], 'source_type': 'SRC_TXT', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
        for _ in range(10): skeleton.append({'section_label': lbls['q_grammar'], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_CLZ_OPT', 'response_mode': 'REQ_DROP'})
        for _ in range(5): skeleton.append({'section_label': lbls['q_grammar'], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_TRF', 'response_mode': 'REQ_INPUT'})
        for _ in range(8): skeleton.append({'section_label': lbls['q_reading'], 'source_type': 'SRC_AUD', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
        for _ in range(2): skeleton.append({'section_label': lbls['q_writing'], 'source_type': 'SRC_DIR', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_DUAL'})
        skeleton.append({'section_label': "Speaking", 'source_type': 'SRC_AUD', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_REC'})
        
        return {
            'requires_api_stimulus': True, 
            'prompt_func': 'generate_languages_stimuli_prompt', 
            'skeleton': skeleton, 
            'itinerary': itinerary, 
            'target_lang': target_lang,
            'reading_header': lbls['reading']
        }

def generate_languages_stimuli_prompt(content_text, subject_name):
    target_lang = get_target_language(subject_name)
    return f"""ACT AS AN ACADEMIC EXAM CHAIR.
TASK: Generate base stimuli for a {target_lang} specialist exam.
STRICT RULE: The 'reading_stimulus' field MUST BE A STRING containing the text only. 
PROHIBITION: DO NOT use nested JSON for 'reading_stimulus'. Do not include 'title' or 'author' as keys.

CONTEXT: {subject_name}.
CONTENT: {content_text[:1200]}
"""

def generate_languages_item_prompt(reading_text, listening_transcript, cefr_level, question_obj, itinerary='MAIOR', target_lang='ENGLISH'):
    q_type = question_obj.interaction_type
    if itinerary == 'MINOR':
        return f"""ACT AS AN HSK EXAM CREATOR (A1-A2). NO READING PASSAGES. TARGET: {target_lang}. RULE: Instructions in Spanish, Content in {target_lang}. NO ENGLISH."""
    
    return f"""ACT AS A CERTACLES EXAMINER ({cefr_level} LEVEL).
STRICT IMMERSION: Use 100% {target_lang}. NO Spanish, NO English.
TASK: Create ONE (1) {q_type} question.
REFERENCE: {reading_text[:800] if 'SRC_TXT' in question_obj.source_type else 'General Language Knowledge'}
JSON SCHEMA: {{"question_text": "...", "options": ["...", "..."], "model_answer": "..."}}
"""
