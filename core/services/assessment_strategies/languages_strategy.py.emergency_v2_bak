import re
import json

def get_script_family(target_lang):
    """Determina si el idioma usa grafías logográficas o latinas."""
    logographic_langs = ["CHINO", "JAPONÉS", "KANJI", "HANZI", "MANDARÍN"]
    return "LOGOGRAPHIC" if any(x in target_lang.upper() for x in logographic_langs) else "LATIN"

def get_target_language(subject_name):
    """Extrae el idioma eliminando el ruido administrativo."""
    clean_name = re.sub(r"\b(LENGUA|MODERNA|MODERNO|MINOR|MAIOR|MÍNOR|INICIAL|INTERMEDIO|AVANZADO|NIVEL|IDIOMA|LENGUA\s+[A-C])\b|[0-9]+|[:()]|\b[IVXLC]+\b", "", subject_name, flags=re.IGNORECASE)
    return clean_name.strip()

def get_strategy_skeleton(content_text, subject_name, **kwargs):
    """Estructura basada en la nueva Capa Nuclear (Itinerario Minor/Maior)."""
    target_lang = get_target_language(subject_name)
    script_family = get_script_family(target_lang)
    itinerary = kwargs.get("itinerary", "MINOR")

    skeleton = []
    if itinerary == "MINOR":
        # Bloque UGR: Vocabulario, Gramática y Sintaxis (Nivel Inicial)
        for _ in range(5): skeleton.append({"section_label": "Vocabulario", "interaction_type": "QT_SEL", "response_mode": "REQ_RADIO"})
        for _ in range(5): skeleton.append({"section_label": "Gramática", "interaction_type": "QT_CLZ_OPT", "response_mode": "REQ_DROP"})
        
        if script_family == "LOGOGRAPHIC":
            skeleton.append({"section_label": "Caligrafía y Trazos", "interaction_type": "QT_PROD", "response_mode": "REQ_DUAL"})
        else:
            skeleton.append({"section_label": "Sintaxis Aplicada", "interaction_type": "QT_ORDER", "response_mode": "REQ_ORDER"})
            
        return {"requires_api_stimulus": False, "skeleton": skeleton, "itinerary": itinerary, "target_lang": target_lang}
    
    # Itinerario MAIOR (CertAcles/CLM - Inmersión Total)
    for _ in range(10): skeleton.append({'section_label': 'Reading Comprehension', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
    for _ in range(10): skeleton.append({'section_label': 'Language Use', 'interaction_type': 'QT_CLZ_OPT', 'response_mode': 'REQ_DROP'})
    for _ in range(5): skeleton.append({'section_label': 'Transformation', 'interaction_type': 'QT_TRF', 'response_mode': 'REQ_INPUT'})
    for _ in range(8): skeleton.append({'section_label': 'Listening', 'interaction_type': 'QT_SEL', 'response_mode': 'REQ_RADIO'})
    for _ in range(2): skeleton.append({'section_label': 'Writing', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_DUAL'})
    skeleton.append({'section_label': 'Speaking', 'interaction_type': 'QT_PROD', 'response_mode': 'REQ_REC'})
    
    return {"requires_api_stimulus": True, "prompt_func": "generate_languages_stimuli_prompt", "skeleton": skeleton, "itinerary": itinerary, "target_lang": target_lang}

def generate_languages_stimuli_prompt(content_text, subject_name, **kwargs):
    """Genera estímulo obligando a la IA a identificar el idioma y usarlo."""
    target_lang = get_target_language(subject_name)
    return f"""ACT AS AN ACADEMIC CHAIR.
TASK: Generate a Reading Stimulus (500 words) in the target language: {target_lang}.
STRICT RULE: The field 'reading_stimulus' MUST contain ONLY the clean text in {target_lang}. 
No JSON nesting. No title/author keys.
CONTENT BASE: {content_text[:1200]}"""

def generate_languages_item_prompt(content_text, listening_transcript, cefr_level, question_obj, **kwargs):
    """PROMPT NUCLEAR: Inyecta Syllabus y Objetivos Reales."""
    target_lang = kwargs.get("target_lang", "IDIOMA")
    objectives = kwargs.get("learning_objectives", "No definidos")
    syllabus = kwargs.get("syllabus", "No definido")
    itinerary = kwargs.get("itinerary", "MINOR")

    return f"""ACT AS AN EXAM CREATOR FOR: {target_lang}.
ITINERARIO: {itinerary} (UGR Style).
PEDAGOGICAL CONTEXT:
- Learning Objectives: {objectives}
- Target Syllabus Content: {syllabus}

TASK: Create ONE (1) question based ONLY on this filtered content:
{content_text[:2500]}

RULE: If it is MINOR, instructions in SPANISH, content in {target_lang}.
SECTION: {question_obj.section_label}
TYPE: {question_obj.interaction_type}
JSON SCHEMA: {{"question_text": "...", "options": [], "model_answer": "..."}}"""
